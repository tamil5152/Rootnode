# Copy this file to .env.local and fill in from Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key

# Optional: free Web3Forms key (get it at https://web3forms.com by entering your email).
# When set, enquiry emails are sent through Web3Forms instead of FormSubmit.
NEXT_PUBLIC_WEB3FORMS_KEY=

# Optional: WhatsApp alert to YOUR phone for every enquiry, via CallMeBot (free).
# These are server-only (no NEXT_PUBLIC_ prefix) so they never reach visitors.
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=
